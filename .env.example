# Copy to .env (never commit it). No credentials are required.
HOST=127.0.0.1
PORT=3000
# SQLite file on persistent storage.
DATA_PATH=./data/tabletop.sqlite
STATIC_DIR=dist/client
# Exact external origin. Required behind a reverse proxy, e.g. https://tables.example.org
ORIGIN=http://127.0.0.1:3000
# Set true whenever the site is served over HTTPS.
COOKIE_SECURE=false
